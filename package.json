{
  "name": "codex-claude-assistant",
  "version": "0.1.0",
  "description": "Codex+Claude assistant installer and configuration wizard for Windows.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "bundle:win10": "npm run build && tauri build",
    "bundle:win7": "npm run build && node scripts/prepare-win7-package.mjs",
    "release:collect": "node scripts/collect-release.mjs",
    "check": "npm run test && npm run build"
  },
  "keywords": [
    "codex",
    "claude",
    "installer",
    "windows",
    "tauri"
  ],
  "author": "QSH36",
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.21.0",
    "postprocessing": "^6.39.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "toml": "^3.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.0.16"
  }
}
